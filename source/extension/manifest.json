{
  "manifest_version": 3,
  "name": "Lateef",
  "version": "0.2.0",
  "description": "Pair an existing Chrome window with model-independent background browser tools.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "tabGroups",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lateef"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  },
  "version_name": "0.2.0 beta 9",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
